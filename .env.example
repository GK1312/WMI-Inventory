# Copy this file to .env and adjust for your machine.

# development | staging | production
APP_ENV=development

# Master switch - when false, logging is fully disabled (NullHandler, no output).
LOGGING_ENABLED=true

# DEBUG | DATA | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=DEBUG

# Rotating log file used only when APP_ENV=production.
LOG_FILE=logs/app.log

# --- PostgreSQL -----------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wmi_inventory
DB_USER=postgres
DB_PASSWORD=
# disable | allow | prefer | require | verify-ca | verify-full
# production refuses to start with disable/allow/prefer.
DB_SSLMODE=prefer
DB_POOL_MIN=1
DB_POOL_MAX=10

# --- API (app/main.py) -----------------------------------------------------
# Bind to loopback by default; put a TLS-terminating reverse proxy in front for remote access.
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated SHA-256 hashes of valid API keys. Generate a key + hash with:
#   .venv/Scripts/python.exe app/core/security.py
# The API refuses to start if this is empty.
API_KEY_HASHES=
# Comma-separated browser origins allowed via CORS; empty disables CORS entirely.
CORS_ORIGINS=
# Comma-separated Host header values the API will answer to.
TRUSTED_HOSTS=localhost,127.0.0.1
# Max request body size in bytes.
MAX_BODY_BYTES=1048576

# --- Credentials ----------------------------------------------------------
# Fernet key used to encrypt tbsyscredmaster.cred_password at rest. Generate with:
#   .venv/Scripts/python.exe app/core/security.py encryption-key
# The API refuses to start if this is empty. Back it up: losing it makes every
# stored credential password unreadable, and the scanner needs the same key to decrypt.
CRED_ENCRYPTION_KEY=
