# Copy this file to .env and adjust for your machine.

# development | staging | production
APP_ENV=development

# Master switch - when false, logging is fully disabled (NullHandler, no output).
LOGGING_ENABLED=true

# DEBUG | DATA | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=DEBUG

# Rotating log file used only when APP_ENV=production.
LOG_FILE=logs/app.log
